# Port & Host server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Kunci sesi internal
SESSION_SECRET=dompetku-dev-session-secret-change-in-production-3827

# Password login admin untuk mode lokal (Default: 3827)
# Di mode production, gunakan hash Bcrypt via ADMIN_PASSWORD_HASH
ADMIN_DEV_PASSWORD=3827

# Origin yang diizinkan untuk CORS
ALLOWED_ORIGIN="http://localhost:5173,http://localhost:5174,https://dompetku.vercel.app"

# Lokasi file database SQLite (otomatis dibuat di server/data/dompetku_stats.db)
DB_PATH="./data/dompetku_stats.db"

# Log level
LOG_LEVEL=info

