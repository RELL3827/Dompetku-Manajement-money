# Port server
PORT=4000
HOST=0.0.0.0

# Node Environment
NODE_ENV=production

# Kunci rahasia session cookie (Ganti dengan string acak panjang di production)
SESSION_SECRET=ganti-dengan-string-rahasia-panjang-dan-acak-minimal-32-karakter

# Hash Bcrypt dari password login admin (Gunakan: npm run hash-password "password_kamu")
# Contoh di bawah ini adalah hash untuk password default: "DompetKuDev2026!"
ADMIN_PASSWORD_HASH="$2a$12$e8yC3fJ6dJgO5Kk7NqZ4Pe7zUe38w0M2nB1cV0aR8tY5uI3oP9mG."

# Origin yang diizinkan untuk CORS (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGIN="http://localhost:5173,http://localhost:5174,https://dompetku.vercel.app"

# Lokasi file database SQLite (otomatis dibuat)
DB_PATH="./data/dompetku_stats.db"

# Log level (info, warn, error)
LOG_LEVEL=info

